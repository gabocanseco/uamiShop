{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".", /* Mantiene la estructura desde la raíz */
    "outDir": "dist", /* Todo lo compilado irá a /dist */
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true, /* Genera los .d.ts solo en dist */
    "declarationMap": true, /* Genera los .map solo en dist */
    "sourceMap": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@catalogo/*": ["src/catalogo/*"],
      "@ventas/*": ["src/venta/*"],
      "@ordenes/*": ["src/ordenes/*"]
    }
  },
  "include": [
    "src/**/*", /* Solo compila lo que esté en src */
    "test/**/*",
  ],
  "exclude": [
    "node_modules",
    "dist",
  ]
}
